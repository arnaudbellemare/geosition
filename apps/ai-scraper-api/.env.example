# ── Provider API keys ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
PERPLEXITY_API_KEY=pplx-...
GEMINI_API_KEY=AIza...
GROK_API_KEY=xai-...

# ── Service ───────────────────────────────────────────────────────────────────
# Change this before deploying — used to create/delete API keys
ADMIN_KEY=change-me-in-production

# SQLite database path (relative to working directory)
DB_PATH=data/scraper.db

# Default monthly query limit for new keys
DEFAULT_MONTHLY_LIMIT=1000

# ── Optional: override default model per provider ────────────────────────────
# OPENAI_MODEL=gpt-4o
# PERPLEXITY_MODEL=sonar-pro
# GEMINI_MODEL=gemini-2.0-flash
# GROK_MODEL=grok-3
