# ─── MVP (default): repo data/ + local collection ───────────────────────────
GEO_DATA_DIR=./data
GEO_USE_REPO_DATA=1
GEO_PLATFORM_BACKEND=sqlite
GEO_ARTIFACT_BACKEND=local

# SQLite paths (optional overrides)
# GEO_PLATFORM_DB=./data/platform.db
# GEO_BENCHMARK_DB=./data/benchmark.db
# GEO_COLLECTION_HOME=./data/collection

# ─── Production: Supabase (auth + Postgres + RLS tables) ─────────────────────
# GEO_PLATFORM_BACKEND=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Blob layer: Fil One (S3-compatible) ─────────────────────────────────────
# https://fil.one/
# GEO_ARTIFACT_BACKEND=s3
# GEO_S3_ENDPOINT=https://YOUR_FIL_ONE_S3_ENDPOINT
# GEO_S3_BUCKET=your-bucket
# GEO_S3_ACCESS_KEY=your-access-key
# GEO_S3_SECRET_KEY=your-secret-key
# GEO_S3_REGION=auto
# GEO_S3_PREFIX=geo-platform

# Aliases (same as GEO_S3_*)
# FIL_ONE_ENDPOINT=
# FIL_ONE_BUCKET=
# FIL_ONE_ACCESS_KEY=
# FIL_ONE_SECRET_KEY=
